<!DOCTYPE html>
<html>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="{% block description %}DailyTrip, l'application de l'aventure{% endblock %}"
    />
    <title>{% block title %}DailyTrip{% endblock %}</title>
    {% block stylesheets %} {% endblock %} {% block javascripts %} {% block
    importmap %}{{
      importmap("app")
    }}{% endblock %} {% endblock %}
  </head>
